{
  "subject_keyword": "代码审核",
  "mailbox": "your-mailbox@agent.qq.com",
  "review_requirements": "",
  "poll_interval_sec": 180,
  "max_workers": 2,
  "max_retries": 3,
  "retry_backoff_sec": 300,
  "max_extracted_mb": 300,
  "max_review_files": 400,
  "review_timeout_sec": 2400,
  "pi_bin": "pi",
  "pi_model": "",
  "pi_thinking": "",
  "attach_report_names": [
    "代码审核报告.md",
    "代码审核报告.html"
  ],
  "ascii_fallback_names": [
    "code-review-report.md",
    "code-review-report.html"
  ],
  "skip_dirs": [
    ".git",
    "node_modules",
    "__pycache__",
    ".venv",
    "venv",
    "dist",
    "build",
    ".idea",
    ".vscode",
    ".mypy_cache",
    ".pytest_cache",
    "target",
    "vendor",
    ".next",
    ".nuxt",
    "coverage",
    ".gradle",
    "bin",
    "obj"
  ],
  "skip_exts": [
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".bmp",
    ".ico",
    ".svg",
    ".webp",
    ".pdf",
    ".zip",
    ".gz",
    ".tar",
    ".rar",
    ".7z",
    ".exe",
    ".dll",
    ".so",
    ".dylib",
    ".mp3",
    ".mp4",
    ".avi",
    ".mov",
    ".woff",
    ".woff2",
    ".ttf",
    ".eot",
    ".class",
    ".jar"
  ],
  "ignore_reply_threads": true,
  "review_chunk_files": 40,
  "llm_backend": "auto",
  "llm_protocol": "openai",
  "llm_base_url": "https://api.deepseek.com",
  "llm_api_key": "",
  "llm_model": "deepseek-chat",
  "llm_thinking": "",
  "llm_disable_thinking": true,
  "llm_temperature": 0.2,
  "llm_max_output_tokens": 16000,
  "llm_timeout_sec": 600,
  "max_chars_per_chunk": 120000,
  "max_file_chars": 30000,
  "fallback_model": "",
  "provider_busy_backoff_sec": 900,
  "require_approval": false,
  "ack_enabled": true,
  "ack_timeout_sec": 300,
  "regression_review": true,
  "regression_max_issues": 80,
  "baseline_similarity": 0.5,
  "same_code_threshold": 0.98,
  "grade_anchor": true,
  "download_cookie": "",
  "download_cookie_file": "",
  "llm_max_concurrency": 2,
  "llm_rate_cooldown_sec": 20,
  "chunk_workers": 2
}
