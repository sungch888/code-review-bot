{
  "subject_keyword": "代码审核",
  "mailbox": "your-mailbox@agent.qq.com",
  "review_requirements": "",
  "poll_interval_sec": 180,
  "max_workers": 1,
  "max_retries": 3,
  "retry_backoff_sec": 300,
  "max_extracted_mb": 300,
  "max_review_files": 400,
  "review_timeout_sec": 2400,
  "pi_bin": "pi",
  "pi_model": "",
  "pi_thinking": "",
  "attach_report_names": [
    "代码审核报告.md",
    "代码审核报告.html"
  ],
  "ascii_fallback_names": [
    "code-review-report.md",
    "code-review-report.html"
  ],
  "skip_dirs": [
    ".git",
    "node_modules",
    "__pycache__",
    ".venv",
    "venv",
    "dist",
    "build",
    ".idea",
    ".vscode",
    ".mypy_cache",
    ".pytest_cache",
    "target",
    "vendor",
    ".next",
    ".nuxt",
    "coverage",
    ".gradle",
    "bin",
    "obj"
  ],
  "skip_exts": [
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".bmp",
    ".ico",
    ".svg",
    ".webp",
    ".pdf",
    ".zip",
    ".gz",
    ".tar",
    ".rar",
    ".7z",
    ".exe",
    ".dll",
    ".so",
    ".dylib",
    ".mp3",
    ".mp4",
    ".avi",
    ".mov",
    ".woff",
    ".woff2",
    ".ttf",
    ".eot",
    ".class",
    ".jar"
  ],
  "ignore_reply_threads": true
}
